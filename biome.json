{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "warn",
        "noConfusingVoidType": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useImportType": "off",
        "useTemplate": "warn",
        "useNumberNamespace": "warn"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn"
      }
    }
  },
  "formatter": {
    "enabled": false
  },
  "files": {
    "excludes": [
      "node_modules/**",
      "dist/**",
      ".wrangler/**",
      "*.lock"
    ]
  }
}
